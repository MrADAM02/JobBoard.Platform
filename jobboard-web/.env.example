# Copy this file to .env and adjust if your API/frontend run somewhere other
# than the defaults below - both are optional, nuxt.config.ts already falls
# back to these exact values if unset.

# JobBoard.Api's http launch profile - deliberately plain HTTP, not HTTPS,
# so server-side fetches during SSR don't hit the API's self-signed dev cert.
NUXT_PUBLIC_API_BASE=https://job-api.jab-eri.org
# Used to build absolute URLs for hreflang alternates and Open Graph tags.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
