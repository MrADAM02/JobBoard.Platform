# Copy this file to .env before running `docker compose up` - docker-compose.yml
# requires both of these and refuses to start otherwise. No dev-only fallback
# on purpose: a known credential baked into the compose file is exactly the
# kind of thing that ends up running for real by accident.

# Signs JWTs issued by the API. Generate one the same way the non-Docker setup
# does (see JobBoard/README.md):
#   openssl rand -base64 48
JWT_SECRET=

# Local Postgres password for the containerized database. Any value works for
# local dev - it's only reachable from other containers on the compose
# network, never exposed via a published port.
POSTGRES_PASSWORD=


CORS_ORIGIN=https://jobboards.netlify.app
