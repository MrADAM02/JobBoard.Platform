# Copy this file to .env to override the defaults docker-compose.yml falls
# back to - none of this is required just to run `docker compose up`.

# Signs JWTs issued by the API. docker-compose.yml falls back to a dev-only
# placeholder if this is unset, which is fine for trying the app locally but
# not for anything beyond that. Generate a real one the same way the non-Docker
# setup does (see JobBoard/README.md):
#   openssl rand -base64 48
JWT_SECRET=
