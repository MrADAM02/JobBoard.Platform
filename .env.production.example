# Copy this to .env on the SERVER (next to docker-compose.prod.yml) - never
# commit the real file. docker-compose.prod.yml refuses to start if any of
# these are missing.

# The server's public IP (or hostname, once you have a domain). Used to build
# the CORS origin and the URLs the frontend points at.
PUBLIC_HOST=

# Real Postgres password for the containerized database - not the "postgres"
# default docker-compose.yml uses for local dev.
POSTGRES_PASSWORD=

# Signs JWTs issued by the API. Generate one the same way as everywhere else
# in this project:
#   openssl rand -base64 48
JWT_SECRET=


# The version of the API image to run. This is a tag on the ghcr.io/mradam02/jobboard-api
API_VERSION=1.0.0